{
  "name": "apsis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Apsis - solar system trajectory design and mission planner (static web application)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint:ste": "node tools/ste/ste-lint.mjs",
    "check:language": "node tools/i18n/second-language.mjs",
    "report": "vitest run --config tools/validation/vitest.config.ts",
    "shots": "node tools/shots/shots.mjs",
    "manual:data": "vitest run --config tools/manual/vitest.config.ts",
    "manual:shots": "npm run build && node tools/manual/shots/capture.mjs",
    "manual:voice": "node tools/manual/narration/speak.mjs && node tools/manual/narration/check.mjs",
    "manual:video": "node tools/manual/video/capture.mjs v1 --video && node tools/manual/video/capture.mjs v2 --video && node tools/manual/video/capture.mjs v3 --video && node tools/manual/video/capture.mjs v4 --video",
    "manual:build": "node tools/manual/page/build.mjs",
    "manual:check": "node tools/manual/page/check.mjs",
    "manual": "npm run manual:data && npm run manual:shots && npm run manual:voice && npm run manual:video && npm run manual:build && npm run manual:check"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
